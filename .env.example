# The Brundain Writer's public URL. Server-only: the browser never calls it.
# Unset, it is a Writer running locally on :8787.
WRITER_API_URL=

# The Clerk user id of the Writer account whose published projects this site lists.
# Unset, it is Sienna's (user_3MXcML9A45c4N9TADGBO5wKcET5), which npm run dev:sienna also runs as.
# Set it to "local" only for a plain local Writer with no owner of its own.
WRITER_OWNER_ID=

# PostHog. With no key there is no consent banner and no tracking. Inlined at build time.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# The site's own address, for absolute OG and canonical URLs. On Vercel the production domain is
# used when this is unset.
SITE_URL=
